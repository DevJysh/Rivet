#!/usr/bin/env python3
"""rivet-gui: a small Tkinter window in front of the rivet command.

It lists the installed AppImages, installs a file you pick, and uninstalls the
selected one. Every change is made by running the rivet binary, so the GUI never
writes the registry or the desktop files itself.

Set RIVET=/path/to/rivet to use a specific binary. Otherwise rivet is looked up
on PATH, and then next to this script.
"""

import os
import re
import shutil
import subprocess
import sys

YES_HINT = "Pass --yes"
SPLIT_COLUMNS = re.compile(r"\s{2,}")


def find_rivet():
    """Returns the path of the rivet binary, or None when it cannot be found."""
    env = os.environ.get("RIVET")
    if env:
        return env if os.access(env, os.X_OK) else None
    found = shutil.which("rivet")
    if found:
        return found
    here = os.path.dirname(os.path.abspath(__file__))
    for candidate in (os.path.join(here, "..", "rivet"), os.path.join(here, "rivet")):
        if os.access(candidate, os.X_OK):
            return candidate
    return None


def run_rivet(rivet, args):
    """Runs rivet with the given arguments and no terminal input.

    Returns (exit status, combined output with surrounding space removed).
    """
    proc = subprocess.run(
        [rivet] + list(args),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    return proc.returncode, proc.stdout.strip()


def parse_list(text):
    """Reads the output of `rivet list` into (name, version, size) tuples.

    Rows are split on runs of two or more spaces, because a size such as
    "182 MB" contains a single space. Lines before the column header, and the
    rule under it, are skipped.
    """
    rows = []
    in_table = False
    for line in text.splitlines():
        stripped = line.strip()
        if not in_table:
            if stripped.startswith("Name") and "Version" in stripped:
                in_table = True
            continue
        if not stripped or set(stripped) <= set("─-"):
            continue
        cells = SPLIT_COLUMNS.split(stripped)
        if len(cells) < 2:
            continue
        name = cells[0]
        version = cells[1] if len(cells) > 1 else ""
        size = cells[2] if len(cells) > 2 else ""
        rows.append((name, version, size))
    return rows


def list_apps(rivet):
    """Returns (rows, error). error is the message to show, or None."""
    status, out = run_rivet(rivet, ["list"])
    if status != 0:
        return [], out or "rivet list failed"
    return parse_list(out), None


def install_file(rivet, path, confirm):
    """Installs path, asking before replacing an installed version.

    confirm(question) is called with the text rivet would have printed, and
    returns True to replace. Returns (ok, message).
    """
    status, out = run_rivet(rivet, ["install", path])
    if status == 0:
        return True, out
    if YES_HINT not in out:
        return False, out or "install failed"
    # rivet refused to replace an installed version without a terminal. Show
    # its message and ask here instead, then repeat the install with --yes.
    if not confirm(out):
        return False, "Nothing was changed."
    status, out = run_rivet(rivet, ["install", "--yes", path])
    return status == 0, out or ("installed" if status == 0 else "install failed")


def uninstall_app(rivet, name):
    """Removes an installed app. Returns (ok, message)."""
    status, out = run_rivet(rivet, ["uninstall", name])
    return status == 0, out or ("removed" if status == 0 else "uninstall failed")


# --- the window ---------------------------------------------------------------


def main():
    rivet = find_rivet()
    if rivet is None:
        sys.stderr.write("rivet-gui: cannot find the rivet command. Set RIVET=/path/to/rivet.\n")
        return 1

    import tkinter as tk
    from tkinter import filedialog, messagebox, ttk

    root = tk.Tk()
    root.title("Rivet")
    root.minsize(520, 320)

    frame = ttk.Frame(root, padding=12)
    frame.pack(fill="both", expand=True)

    table = ttk.Treeview(frame, columns=("name", "version", "size"), show="headings", selectmode="browse")
    table.heading("name", text="Name")
    table.heading("version", text="Version")
    table.heading("size", text="Size")
    table.column("name", width=220)
    table.column("version", width=120)
    table.column("size", width=100, anchor="e")
    table.pack(fill="both", expand=True)

    status_var = tk.StringVar(value="")
    ttk.Label(frame, textvariable=status_var, wraplength=500, justify="left").pack(fill="x", pady=(8, 8))

    buttons = ttk.Frame(frame)
    buttons.pack(fill="x")

    def refresh():
        table.delete(*table.get_children())
        rows, error = list_apps(rivet)
        if error:
            status_var.set(error)
            return
        for row in rows:
            table.insert("", "end", values=row)
        status_var.set(f"{len(rows)} installed")

    def ask(question):
        return messagebox.askyesno("Rivet", question + "\n\nReplace the installed version?")

    def on_install():
        path = filedialog.askopenfilename(
            title="Choose an AppImage",
            filetypes=[("AppImage files", "*.AppImage *.appimage"), ("All files", "*")],
        )
        if not path:
            return
        ok, message = install_file(rivet, path, ask)
        if ok:
            status_var.set(message)
        else:
            messagebox.showerror("Rivet", message)
        refresh()

    def on_uninstall():
        selected = table.selection()
        if not selected:
            status_var.set("Select an app to uninstall.")
            return
        name = table.item(selected[0], "values")[0]
        if not messagebox.askyesno("Rivet", f"Remove {name}?"):
            return
        ok, message = uninstall_app(rivet, name)
        if ok:
            status_var.set(message)
        else:
            messagebox.showerror("Rivet", message)
        refresh()

    ttk.Button(buttons, text="Install AppImage...", command=on_install).pack(side="left")
    ttk.Button(buttons, text="Uninstall", command=on_uninstall).pack(side="left", padx=(8, 0))
    ttk.Button(buttons, text="Refresh", command=refresh).pack(side="right")

    refresh()
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
